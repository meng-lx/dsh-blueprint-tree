{
  "name": "dsh-blueprint-tree",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的可执行蓝图插件：用子蓝图组织项目，把单元依赖画出来，让 AI 按范围改，让人按图检查。 Executable blueprint workflows for DeepSeek Harness.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "blueprint",
    "workflow",
    "graph",
    "agent-workflow"
  ],
  "license": "MIT",
  "author": "meng-lx <203744120+meng-lx@users.noreply.github.com>",
  "homepage": "https://github.com/meng-lx/dsh-blueprint-tree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meng-lx/dsh-blueprint-tree.git"
  },
  "bugs": {
    "url": "https://github.com/meng-lx/dsh-blueprint-tree/issues"
  },
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "src/host/index.ts",
  "exports": {
    ".": "./src/host/index.ts",
    "./client": "./src/client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets/",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  }
}
